# Image MCP 配置
# 复制此文件为 .env 并填写你的 API 密钥

# 通义千问 VL（图像理解）
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# OpenAI GPT Image 2.5（图像生成，默认引擎）
# 获取 API Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 中转 / 代理端点（可选，走 OpenAI 官方则删除或留空）
# 例如第三方中转站: https://api.example-relay.com/v1
# 兼容 OpenRouter（自动识别 openrouter.ai 域名并适配命名空间模型名）
OPENAI_BASE_URL=

# GPT Image 2.5 模型配置（可选，不配置则使用默认值）
# 快速档（默认，速度优先）
OPENAI_IMAGE_MODEL_FAST=gpt-image-2.5-flare
# 精修档（pro=true 时使用，编辑精度优先）
OPENAI_IMAGE_MODEL_PRO=gpt-image-2.5-sunburst

# Gemini（图像生成，可选备选引擎，engine="gemini" 时使用）
# 获取 API Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 模型配置（可选，不配置则使用默认值）
# Flash 模型（默认，快速生成）
GEMINI_FLASH_MODEL=gemini-3.1-flash-image-preview
# Pro 模型（高质量生成）
GEMINI_PRO_MODEL=gemini-3-pro-image-preview

# 智谱 AI（文档版面解析 OCR，可选）
ZHIPU_API_KEY=your_zhipu_api_key_here
